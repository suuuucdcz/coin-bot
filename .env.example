# Le plus simple : double-clique sur configurer.bat, il remplit ce fichier pour toi.
# (sinon : copie ce fichier en .env et remplis les valeurs à la main)

# Helius (gratuit) : https://dashboard.helius.dev -> API Keys
HELIUS_API_KEY=
# Bot Telegram (@BotFather) et conversation où envoyer les alertes
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (Optionnel) RPC de secours si pas de clé Helius — historique limité, à éviter en production
SOLANA_RPC_URL=

# Veille X (gratuite, navigateur Edge connecté à ton compte X via connexion_x.bat)
X_PROFILE_DIR=./data/x_profile
X_ACCOUNTS=zenkaixbt,1dev_zen
# secondes entre deux tours de recherche (augmente si X te bloque)
X_POLL_SECONDS=180
# 0 pour couper la veille X
X_ENABLED=1
# msedge (défaut), chrome, ou chromium (celui de Playwright)
X_BROWSER=msedge
# 0 pour voir la fenêtre du navigateur (utile si X bloque le mode invisible)
X_HEADLESS=1
# pause de nuit de la veille X, heure de Paris (0 = jamais de pause)
X_QUIET_HOURS=3-8

# Traçage
TRACE_MAX_HOPS=3
HOT_WALLET_TX_THRESHOLD=1000

# Alertes temps réel
# funding minimum d'un nouveau wallet pour alerter (SOL)
FUNDING_MIN_SOL=0.05
# retour de SOL d'un dev vers le bank = profits rapatriés (SOL)
PROFIT_MIN_SOL=5
# groupes de la watchlist connus pour des rugs (alertes marquées 🚩)
RUG_GROUPS=reserve-cluster

# Watchlist : nombre max d'adresses suivies (plan gratuit Helius) et purge des wallets inactifs
WATCH_MAX=300
WATCH_STALE_DAYS=10

# Découverte automatique de devs (créateurs pump.fun qui ont réussi un lancement récent)
DISCOVERY_ENABLED=1
# ATH minimum en $ pour qu'un lancement compte comme un succès
DISCOVERY_MIN_ATH=500000
DISCOVERY_EVERY_H=6

# (Optionnel) IA Jev de TypeSafe : avis rapide en plus des règles (tweets, comptes X). https://console.typesafe.ai
TYPESAFE_API_KEY=
