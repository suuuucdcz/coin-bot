# Le plus simple : double-clique sur configurer.bat, il remplit ce fichier pour toi.
# (sinon : copie ce fichier en .env et remplis les valeurs à la main)

# Helius (gratuit) : https://dashboard.helius.dev -> API Keys
HELIUS_API_KEY=
# Bot Telegram (@BotFather) et conversation où envoyer les alertes
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Ton identifiant Telegram (le bot ne répond qu'au groupe et à toi en privé)
TELEGRAM_ADMINS=
# « À ne pas rater » : où envoyer les SEULES alertes vérifiées, avec le son (par défaut : ta conversation
# privée avec le bot = 1er admin). Le groupe passe alors en silencieux.
TELEGRAM_TOP_CHAT_ID=
# (Optionnel) bouton « Ouvrir sur ma plateforme » : ouvre un token sur ta plateforme, copie l'adresse de la page
# et remplace le CA par {mint}. Exemple de forme : https://exemple.com/token/{mint}
TRADE_URL=

# (Optionnel) RPC de secours si pas de clé Helius — historique limité, à éviter en production
SOLANA_RPC_URL=

# Veille X (gratuite, navigateur Edge connecté à ton compte X via connexion_x.bat)
X_PROFILE_DIR=./data/x_profile
X_ACCOUNTS=zenkaixbt,1dev_zen
# secondes entre deux tours de recherche (augmente si X te bloque)
X_POLL_SECONDS=180
# 0 pour couper la veille X
X_ENABLED=1
# msedge (défaut), chrome, ou chromium (celui de Playwright)
X_BROWSER=msedge
# 0 pour voir la fenêtre du navigateur (utile si X bloque le mode invisible)
X_HEADLESS=1
# 1 = navigateur allégé (images, vidéos et polices non chargées) pour un petit serveur (1 Go de mémoire)
X_LIGHT=0
# pause de nuit de la veille X, heure de Paris (0 = jamais de pause)
X_QUIET_HOURS=3-8

# Traçage
TRACE_MAX_HOPS=3
HOT_WALLET_TX_THRESHOLD=1000

# Alertes temps réel
# funding minimum d'un nouveau wallet pour alerter (SOL)
FUNDING_MIN_SOL=0.05
# retour de SOL d'un dev vers le bank = profits rapatriés (SOL)
PROFIT_MIN_SOL=5
# groupes de la watchlist connus pour des rugs (alertes marquées 🚩)
RUG_GROUPS=reserve-cluster

# Watchlist : nombre max d'adresses suivies (plan gratuit Helius) et purge des wallets inactifs
# jusqu'à 4 500 avec le plan gratuit Helius (5 connexions x 900 wallets) : les wallets qui dorment ne coûtent rien
WATCH_MAX=2000
WATCH_STALE_DAYS=10

# Découverte automatique de devs (créateurs pump.fun qui ont réussi un lancement récent)
DISCOVERY_ENABLED=1
# ATH minimum en $ pour qu'un lancement compte comme un succès
DISCOVERY_MIN_ATH=500000
DISCOVERY_EVERY_H=3

# (Optionnel) IA Jev de TypeSafe : avis rapide en plus des règles (tweets, comptes X). https://console.typesafe.ai
TYPESAFE_API_KEY=

# IA locale (Ollama + Gemma 4 sur ta carte graphique) : lit les tweets (texte ET images) et choisit les
# prochaines recherches X. Gratuit, privé. Ne clique jamais rien et ne déclenche jamais « À ne pas rater ».
# 0 pour la couper. Modèle : gemma4:e4b (9,6 Go) ou gemma4:e2b (7,2 Go, plus léger)
LLM_ENABLED=1
LLM_MODEL=gemma4:e4b
LLM_URL=http://127.0.0.1:11434
# Sur un serveur sans carte graphique : API Gemini (clé gratuite sur aistudio.google.com/apikey, créée dans un
# projet SANS facturation, sinon c'est le palier payant). Avec une clé, LLM_PROVIDER passe à gemini tout seul.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# plafond d'appels par jour (le palier gratuit de Flash-Lite en autorise environ 500)
LLM_DAILY_MAX=450
